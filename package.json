  },
  "scripts": {
    "test": "node --test",
    "gen:tables": "node scripts/gen-tables.js"
  },
  "keywords": [
    "mojibake",
    "encoding",
    "utf8",
    "latin1",
    "cp1251",
    "cp1252",
    "text",
    "i18n",
    "zero-dependency"
  ],
  "license": "MIT",
  "author": "Xwalims",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin",
    "src",
    "spec",
    "scripts",
    "README.md",
    "LICENSE"
  ]
}
